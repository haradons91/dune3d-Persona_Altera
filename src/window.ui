<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 0.90.4 -->
<interface>
  <!-- interface-name window.ui -->
  <requires lib="gtk" version="4.10"/>
  <object class="GtkApplicationWindow" id="window">
    <property name="default-height">750</property>
    <property name="default-width">1024</property>
    <property name="title">Dune 3D</property>
    <property name="titlebar">
      <object class="GtkHeaderBar" id="titlebar">
        <property name="title-widget">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">3</property>
            <property name="valign">center</property>
            <child>
              <object class="GtkLabel" id="title_label">
                <property name="css-classes">window-title-label</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="subtitle_label">
                <property name="css-classes">window-subtitle-label
dim-label</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="window_command_bar">
            <property name="orientation">horizontal</property>
            <property name="spacing">4</property>
            <property name="margin-start">8</property>
            <property name="margin-end">8</property>
            <property name="margin-top">4</property>
            <property name="margin-bottom">4</property>
            <child>
              <object class="GtkBox">
                <property name="css-classes">linked</property>
                <child>
                  <object class="GtkButton" id="open_button">
                    <property name="label">Open</property>
                  </object>
                </child>
                <child>
                  <object class="GtkMenuButton" id="open_menu_button">
                    <property name="popover">
                      <object class="GtkPopover" id="open_popover">
                        <property name="visible">false</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <child>
                              <object class="GtkSearchEntry" id="open_recent_search_entry"/>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="has-frame">True</property>
                                <property name="hscrollbar-policy">never</property>
                                <property name="max-content-height">500</property>
                                <property name="min-content-height">100</property>
                                <property name="propagate-natural-height">True</property>
                                <child>
                                  <object class="GtkListBox" id="open_recent_listbox">
                                    <property name="selection-mode">none</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="new_button">
                    <property name="icon-name">document-new-symbolic</property>
                    <property name="tooltip-text">Create new document</property>
                    <property name="visible">false</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="save_button">
                    <property name="label">Save</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="save_as_button">
                    <property name="icon-name">document-save-as-symbolic</property>
                    <property name="tooltip-text">Save As</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="window_undo_redo_box">
                    <property name="css-classes">linked</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="window_document_tabs">
                    <property name="css-classes">document-tab-strip</property>
                    <property name="spacing">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="window_new_document_tab_button">
                    <property name="label">+</property>
                    <property name="tooltip-text">Create new document</property>
                    <property name="css-classes">document-tab new-document-tab</property>
                    <property name="has-frame">false</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="pick_button">
                    <property name="label">Pick</property>
                    <property name="tooltip-text">Dump pick bufffer</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="hexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="css-classes">linked</property>
                <child>
                  <object class="GtkButton" id="screenshot_button">
                    <property name="label">Screenshot</property>
                    <property name="tooltip-text">Save a screenshot of the Dune3D window</property>
                  </object>
                </child>
                <child>
                  <object class="GtkMenuButton" id="hamburger_menu_button">
                    <property name="icon-name">open-menu-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
