                <child>
                  <object class="GtkButton" id="ribbon_sketch_btn_measure">
                    <property name="css-classes">fusion-ribbon-btn</property>
                    <property name="tooltip-text">Measure Distance</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">2</property>
                        <child><object class="GtkImage"><property name="icon-name">action-clip-greater-symbolic</property><property name="icon-size">large</property></object></child>
                        <child><object class="GtkLabel"><property name="css-classes">fusion-ribbon-btn-label</property><property name="label">Measure</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>
                <child><object class="GtkLabel"><property name="css-classes">fusion-ribbon-group-label</property><property name="label">INSPECT</property></object></child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="ribbon_insert_group">
                <property name="css-classes">fusion-ribbon-group</property>
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkMenuButton" id="ribbon_insert_menu_button">
                    <property name="css-classes">fusion-ribbon-group-label fusion-ribbon-create-menu</property>
                    <property name="has-frame">False</property>
                    <property name="tooltip-text">Insert external geometry and components</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">3</property>
                        <property name="halign">center</property>
                        <child><object class="GtkLabel"><property name="css-classes">fusion-ribbon-create-label</property><property name="label">INSERT</property></object></child>
                        <child><object class="GtkImage"><property name="icon-name">pan-down-symbolic</property><property name="pixel-size">10</property></object></child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="finish_sketch_group">
                <property name="css-classes">fusion-ribbon-group</property>
                <property name="orientation">vertical</property>
                <property name="visible">False</property>
                <child>
                  <object class="GtkButton" id="finish_sketch_button">
                    <property name="css-classes">fusion-ribbon-btn</property>
                    <property name="tooltip-text">Finish Sketch</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">2</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">emblem-ok-symbolic</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                        <child>
                      <object class="GtkLabel">
                        <property name="css-classes">fusion-ribbon-btn-label</property>
                        <property name="label">Finish</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="finish_sketch_label">
                    <property name="css-classes">fusion-ribbon-group-label</property>
                    <property name="label">SKETCH</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkPaned" id="paned">
            <property name="position">300</property>
            <property name="position-set">True</property>
            <property name="resize-end-child">False</property>
            <property name="shrink-start-child">False</property>
            <child>
              <object class="GtkPaned" id="left_bar">
                <property name="orientation">vertical</property>
                <property name="position">400</property>
                <property name="position-set">True</property>
                <property name="resize-end-child">False</property>
                <property name="shrink-end-child">False</property>
                <property name="shrink-start-child">False</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkInfoBar" id="version_info_bar">
                    <property name="message-type">warning</property>
                    <property name="revealed">False</property>
                    <child>
                      <object class="GtkLabel" id="version_info_bar_label">
                        <property name="hexpand">True</property>
                        <property name="label">lalala</property>
                        <property name="wrap">True</property>
                        <property name="xalign">0.0</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkOverlay">
                    <property name="vexpand">True</property>
                    <child type="overlay">
                      <object class="GtkBox" id="cube_box">
                        <property name="can-target">True</property>
                        <property name="halign">end</property>
                        <property name="margin-end">10</property>
                        <property name="margin-top">10</property>
                        <property name="valign">start</property>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkBox" id="sketch_plane_selector_box">
                        <property name="can-target">True</property>
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkBox" id="rectangle_dimensions_box">
                        <property name="can-target">True</property>
                        <property name="halign">start</property>
                        <property name="valign">start</property>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkBox" id="welcome_box">
                        <property name="css-classes">background
welcome-box</property>
                        <property name="visible">false</property>
                        <property name="halign">center</property>
                        <property name="margin-bottom">100</property>
                        <property name="margin-top">100</property>
                        <property name="orientation">vertical</property>
                        <property name="valign">center</property>
                        <child>
                          <object class="GtkBox">
                            <property name="margin-bottom">20</property>
                            <property name="margin-end">20</property>
                            <property name="margin-start">20</property>
                            <property name="spacing">20</property>
                            <child>
                              <object class="GtkBox">
                                <property name="margin-top">20</property>
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkLabel" id="welcome_recent_label">
                                    <property name="label">&lt;b&gt;Open recent&lt;/b&gt;</property>
                                    <property name="margin-bottom">10</property>
                                    <property name="use-markup">True</property>
                                    <property name="xalign">0.0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSearchEntry" id="welcome_recent_search_entry">
                                    <property name="margin-bottom">5</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkScrolledWindow">
                                    <property name="has-frame">True</property>
                                    <property name="hscrollbar-policy">never</property>
                                    <property name="min-content-height">400</property>
                                    <property name="vexpand">True</property>
                                    <property name="width-request">300</property>
                                    <child>
                                      <object class="GtkListBox" id="welcome_recent_listbox">
                                        <property name="selection-mode">none</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="margin-top">20</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkButton" id="welcome_new_button">
                                    <property name="child">
                                      <object class="GtkBox">
                                        <property name="spacing">10</property>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">document-new-symbolic</property>
                                            <property name="icon-size">large</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">10</property>
                                            <property name="vexpand-set">True</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label">&lt;b&gt;Create a new document&lt;/b&gt;</property>
                                                <property name="use-markup">True</property>
                                                <property name="vexpand">True</property>
                                                <property name="xalign">0.0</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="welcome_open_button">
                                    <property name="child">
                                      <object class="GtkBox">
                                        <property name="spacing">10</property>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">document-open-symbolic</property>
                                            <property name="icon-size">large</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="spacing">10</property>
                                            <property name="vexpand-set">True</property>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label">&lt;b&gt;Open existing document&lt;/b&gt;</property>
                                                <property name="use-markup">True</property>
                                                <property name="vexpand">True</property>
                                                <property name="xalign">0.0</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">10</property>
                                    <property name="valign">end</property>
                                    <property name="vexpand">True</property>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="icon-name">help-browser-symbolic</property>
                                        <property name="icon-size">large</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="hexpand">True</property>
                                        <property name="label">New here? Check out the &lt;a href="https://docs.dune3d.org/"&gt;documentation&lt;/a&gt; and the &lt;a href="https://docs.dune3d.org/en/latest/simple-part.html"&gt;tutorial&lt;/a&gt;.</property>
                                        <property name="max-width-chars">0</property>
                                        <property name="natural-wrap-mode">word</property>
                                        <property name="use-markup">True</property>
                                        <property name="wrap">True</property>
                                        <property name="xalign">0.0</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">10</property>
                                    <property name="valign">end</property>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="icon-name">dialog-information-symbolic</property>
                                        <property name="icon-size">large</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="halign">start</property>
                                        <property name="hexpand">True</property>
                                        <property name="justify">fill</property>
                                        <property name="label">Press space anywhere in the 3D viewport to open the searchable global menu.</property>
                                        <property name="max-width-chars">0</property>
                                        <property name="natural-wrap-mode">word</property>
                                        <property name="wrap">True</property>
                                        <property name="xalign">0.0</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkRevealer" id="action_bar_revealer">
                        <property name="halign">start</property>
                        <property name="margin-top">50</property>
                        <property name="reveal-child">True</property>
                        <property name="transition-type">slide-right</property>
                        <property name="valign">start</property>
                        <child>
                          <object class="GtkBox" id="action_bar_box">
                            <property name="margin-end">7</property>
                            <property name="margin-start">7</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">5</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkRevealer" id="delete_revealer">
                        <property name="css-classes">osd
delete-revealer</property>
                        <property name="halign">center</property>
                        <property name="margin-bottom">80</property>
                        <property name="reveal-child">True</property>
                        <property name="transition-type">none</property>
                        <property name="valign">end</property>
                        <child>
                          <object class="GtkBox">
                            <child>
                              <object class="GtkBox">
                                <property name="margin-bottom">10</property>
                                <property name="margin-end">10</property>
                                <property name="margin-start">10</property>
                                <property name="margin-top">10</property>
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkExpander" id="delete_expander">
                                    <property name="label">Deleted....</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="delete_detail_label">
                                    <property name="label">blah
blah</property>
                                    <property name="margin-start">10</property>
                                    <property name="vexpand">True</property>
                                    <property name="xalign">0.0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="css-classes">linked</property>
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkButton" id="delete_undo_button">
                                    <property name="child">
                                      <object class="GtkLabel">
                                        <property name="label">Undo</property>
                                        <property name="width-chars">7</property>
                                        <property name="xalign">0.0</property>
                                      </object>
                                    </property>
                                    <property name="vexpand">True</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="delete_close_button">
                                    <property name="child">
                                      <object class="GtkLabel" id="delete_close_label">
                                        <property name="css-classes">tnum</property>
                                        <property name="label">Close</property>
                                        <property name="width-chars">7</property>
                                        <property name="xalign">0.0</property>
                                      </object>
                                    </property>
                                    <property name="vexpand">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="canvas_box">
                        <property name="vexpand">True</property>
                      </object>
                    </child>

                    <child type="overlay">
                      <object class="GtkRevealer" id="tool_bar">
                        <property name="can-target">False</property>
                        <property name="transition-type">slide-up</property>
                        <property name="valign">end</property>
                        <child>
                          <object class="GtkBox">
                            <property name="margin-bottom">8</property>
                            <property name="margin-end">8</property>
                            <property name="margin-start">8</property>
                            <property name="margin-top">8</property>
                            <property name="spacing">20</property>
                            <child>
                              <object class="GtkLabel" id="tool_bar_name_label">
                                <property name="label">Tool frobniacate</property>
                                <style>
                                  <class name="dune3d-tool-bar-name-label"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStack" id="tool_bar_stack">
                                <property name="transition-type">slide-up-down</property>
                                <child>
                                  <object class="GtkLabel" id="tool_bar_flash_label">
                                    <property name="label">flash</property>
                                    <property name="xalign">0.0</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="tool_bar_box">
                                    <property name="spacing">10</property>
                                    <child>
                                      <object class="GtkBox" id="tool_bar_actions_box">
                                        <property name="spacing">10</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="tool_bar_tip_label">
                                        <property name="css-classes">tnum</property>
                                        <property name="label">tip</property>
                                        <property name="xalign">0.0</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <style>
                          <class name="osd"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkNotebook" id="workspace_notebook">
                    <property name="show-border">False</property>
                    <property name="tab-pos">bottom</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="timeline_panel">
                    <property name="height-request">92</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkSeparator"/>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Timeline</property>
                        <property name="margin-start">8</property>
                        <property name="xalign">0</property>
                        <style><class name="dim-label"/></style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">automatic</property>
                        <property name="vscrollbar-policy">never</property>
                        <property name="hexpand">True</property>
                        <child>
                          <object class="GtkBox" id="timeline_items_box">
                            <property name="margin-bottom">6</property>
                            <property name="margin-end">8</property>
                            <property name="margin-start">8</property>
                            <property name="margin-top">2</property>
                            <property name="spacing">4</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator"/>
        </child>
        <child>
          <object class="GtkBox">
            <property name="margin-start">6</property>
            <property name="spacing">10</property>
            <child>
              <object class="GtkLabel" id="selection_mode_label">
                <property name="label">selection mode</property>
                <property name="width-chars">10</property>
                <property name="xalign">0.0</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="key_hint_label">
                <property name="label">fixme</property>
                <property name="margin-bottom">4</property>
                <property name="margin-end">4</property>
                <property name="margin-start">4</property>
                <property name="margin-top">4</property>
                <property name="width-chars">20</property>
                <property name="xalign">0.0</property>
                <style/>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="workplane_checkbutton">
                <property name="active">True</property>
                <property name="child">
                  <object class="GtkLabel" id="workplane_label">
                    <property name="label">workplane goes here</property>
                    <property name="width-chars">35</property>
                    <property name="xalign">0.0</property>
                  </object>
                </property>
                <property name="tooltip-text">Use workplane</property>
              </object>
            </child>
            <child>
              <object class="GtkMenuButton" id="view_options_button">
                <property name="child">
                  <object class="GtkBox">
                    <property name="spacing">3</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">pan-up-symbolic</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="view_hints_label">
                        <property name="label">View</property>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="css-classes">view-options-button</property>
                <property name="direction">up</property>
                <property name="has-frame">False</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
